generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  FACILITADORA
  ARTESANA
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  TEXT
  VIDEO
  AUDIO
  PDF
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  UNAVAILABLE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WorkshopStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum WorkshopMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum NotificationType {
  SYSTEM
  LEARNING
  COMMUNITY
  ORDER
  PAYMENT
  SUPPORT
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  CERTIFICATE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
}

enum BadgeType {
  LEARNING
  CULTURE
  IMPACT
  PROGRESS
}

enum WorkshopRegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum FollowUpType {
  ACADEMIC
  DIGITAL
  COMMERCIAL
  PERSONAL
  WORKSHOP
  OTHER
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

enum FacilitatorAssignmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum AnnouncementType {
  FAIR
  CONTEST
  TRAINING
  PROGRAM
  OTHER
}

enum CraftTypeEnum {
  TEJIDO
  BORDADO
  CERAMICA
  JOYERIA
  TEXTIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  RESET_PASSWORD
}

enum PaymentMethodType {
  YAPE
  PLIN
  BANK_ACCOUNT
  OTHER
}

enum PaymentMethodStatus {
  PENDING
  ACTIVE
  DISABLED
  REJECTED
}

enum LedgerEntryType {
  SALE
  PAYOUT
  PLATFORM_FEE
  REFUND
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                    String                  @id @default(uuid())
  name                  String?
  email                 String                  @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  locale                String                  @default("es")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  profile               Profile?
  userRoles             UserRoleAssignment[]
  accounts              Account[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]    @relation("UserPasswordResetTokens")
  enrollments           Enrollment[]
  wallet                Wallet?
  paymentMethods        PaymentMethod[]
  ledgerEntries         LedgerEntry[]
  payouts               Payout[]
  products              Product[]               @relation("ArtisanProducts")
  orders                Order[]                 @relation("BuyerOrders")
  workshopsFacilitated  Workshop[]              @relation("FacilitatedWorkshops")
  coursesFacilitated    Course[]                @relation("FacilitatedCourses")
  workshopRegistrations WorkshopRegistration[]
  attendances           Attendance[]
  participants          Participant[]
  messages              Message[]               @relation("SentMessages")
  notifications         Notification[]
  stories               Story[]
  certificates          Certificate[]
  announcements         Announcement[]          @relation("AnnouncementAuthor")
  auditLogs             AuditLog[]              @relation("AuditActor")
  userBadges            UserBadge[]
  createdConversations  Conversation[]
  files                 File[]
  facilitatedArtisans   FacilitatorAssignment[] @relation("AssignmentFacilitator")
  artisanFacilitators   FacilitatorAssignment[] @relation("AssignmentArtisan")
  followUpsCreated      ArtisanFollowUp[]       @relation("FollowUpFacilitator")
  followUpsReceived     ArtisanFollowUp[]       @relation("FollowUpArtisan")
  attendanceRecorded    Attendance[]            @relation("AttendanceRecorder")
}

model Role {
  id          String               @id @default(uuid())
  name        UserRole             @unique
  description String?
  userRoles   UserRoleAssignment[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String
  lastName    String
  displayName String
  phone       String?
  locale      String    @default("es")
  bio         String?
  avatarUrl   String?
  communityId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  community  Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  craftTypes ProfileCraftType[]

  @@index([communityId])
}

model Community {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  profiles               Profile[]
  products               Product[]
  stories                Story[]
  announcements          Announcement[]
  workshops              Workshop[]
  facilitatorAssignments FacilitatorAssignment[]

  @@index([name])
}

model CraftType {
  id          String        @id @default(uuid())
  key         CraftTypeEnum @unique
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  profiles ProfileCraftType[]
  courses  CourseCraftType[]
  products Product[]
  stories  Story[]
}

model ProfileCraftType {
  id          String @id @default(uuid())
  profileId   String
  craftTypeId String

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  craftType CraftType @relation(fields: [craftTypeId], references: [id], onDelete: Restrict)

  @@unique([profileId, craftTypeId])
  @@index([craftTypeId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products         Product[]
  courseCategories CourseCategory[]
}

model Course {
  id            String       @id @default(uuid())
  title         String
  slug          String       @unique
  description   String?
  level         CourseLevel  @default(BEGINNER)
  status        CourseStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  facilitatorId String?
  durationMin   Int?
  imageUrl      String?

  modules          Module[]
  enrollments      Enrollment[]
  courseCategories CourseCategory[]
  craftTypes       CourseCraftType[]
  workshops        Workshop[]
  certificates     Certificate[]
  facilitator      User?             @relation("FacilitatedCourses", fields: [facilitatorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([level])
  @@index([facilitatorId])
}

model CourseCategory {
  id         String @id @default(uuid())
  courseId   String
  categoryId String

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([courseId, categoryId])
  @@index([categoryId])
}

model CourseCraftType {
  id          String @id @default(uuid())
  courseId    String
  craftTypeId String

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  craftType CraftType @relation(fields: [craftTypeId], references: [id], onDelete: Restrict)

  @@unique([courseId, craftTypeId])
  @@index([craftTypeId])
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  durationMin Int?
  coverFileId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coverFile File?      @relation("ModuleCoverFile", fields: [coverFileId], references: [id], onDelete: SetNull)
  lessons   Lesson[]
  workshops Workshop[]

  @@index([courseId])
  @@index([coverFileId])
  @@index([order])
}

model Lesson {
  id          String     @id @default(uuid())
  moduleId    String
  title       String
  slug        String     @unique
  type        LessonType @default(TEXT)
  content     String?
  durationMin Int?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]
  lessonFiles      LessonFile[]

  @@index([moduleId])
  @@index([order])
}

model Enrollment {
  id             String           @id @default(uuid())
  userId         String
  courseId       String
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lastActivityAt DateTime?

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseProgress   CourseProgress?
  lessonProgresses LessonProgress[]

  @@unique([userId, courseId])
  @@index([status])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(uuid())
  enrollmentId   String
  lessonId       String
  completed      Boolean   @default(false)
  progress       Float     @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime?
  updatedAt      DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model CourseProgress {
  id               String   @id @default(uuid())
  enrollmentId     String   @unique
  completedLessons Int      @default(0)
  totalLessons     Int      @default(0)
  percentage       Float    @default(0)
  lastProgressAt   DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  type        BadgeType @default(LEARNING)
  iconUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  reason    String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  issuedAt  DateTime @default(now())
  fileId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  file   File?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
}

model Story {
  id              String    @id @default(uuid())
  userId          String
  communityId     String?
  craftTypeId     String?
  title           String
  summary         String?
  content         String
  publicName      String?
  personalStory   String?
  artisanJourney  String?
  knowledgeOrigin String?
  learnedFrom     String?
  techniques      String?
  culturalMeaning String?
  coverImageId    String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  community  Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  craftType  CraftType?  @relation(fields: [craftTypeId], references: [id], onDelete: SetNull)
  coverImage File?       @relation("StoryCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  storyFiles StoryFile[]

  @@index([communityId])
  @@index([craftTypeId])
}

model StoryFile {
  id      String @id @default(uuid())
  storyId String
  fileId  String
  order   Int    @default(0)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([storyId, fileId])
  @@index([storyId])
  @@index([fileId])
}

model Product {
  id              String        @id @default(uuid())
  artisanId       String
  categoryId      String
  communityId     String
  craftTypeId     String
  name            String
  slug            String        @unique
  description     String?
  culturalPhrase  String?
  story           String?
  makingTime      String?
  materials       String?
  technique       String?
  culturalMeaning String?
  inspiration     String?
  process         String?
  tradition       String?
  available       Boolean       @default(true)
  price           Decimal
  currency        String        @default("PEN")
  status          ProductStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  artisan    User           @relation("ArtisanProducts", fields: [artisanId], references: [id], onDelete: Restrict)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  community  Community      @relation(fields: [communityId], references: [id], onDelete: Restrict)
  craftType  CraftType      @relation(fields: [craftTypeId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([status])
  @@index([communityId])
  @@index([craftTypeId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  fileId    String  @unique
  altText   String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id            String      @id @default(uuid())
  buyerId       String
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal
  currency      String      @default("PEN")
  placedAt      DateTime    @default(now())
  fulfilledAt   DateTime?
  cancelledAt   DateTime?
  shippingNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyer   User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  payment Payment?

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int     @default(1)
  unitPrice  Decimal
  totalPrice Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  provider  String
  balance   Decimal  @default(0)
  currency  String   @default("PEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]
  paymentMethods PaymentMethod[]
  ledgerEntries  LedgerEntry[]
  payouts        Payout[]
}

model PaymentMethod {
  id           String              @id @default(uuid())
  userId       String
  walletId     String?
  type         PaymentMethodType
  status       PaymentMethodStatus @default(PENDING)
  label        String
  holderName   String?
  phone        String?
  bankName     String?
  accountLast4 String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet  Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  payouts Payout[]

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  walletId   String?
  amount     Decimal
  currency   String        @default("PEN")
  status     PaymentStatus @default(PENDING)
  provider   String
  reference  String?
  paidAt     DateTime?
  failedAt   DateTime?
  refundedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wallet        Wallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([orderId])
  @@index([status])
}

model LedgerEntry {
  id          String            @id @default(uuid())
  userId      String
  walletId    String
  paymentId   String?
  payoutId    String?
  type        LedgerEntryType
  status      LedgerEntryStatus @default(PENDING)
  amount      Decimal
  currency    String            @default("PEN")
  description String?
  reference   String?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payout  Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@index([paymentId])
  @@index([payoutId])
  @@index([type])
  @@index([status])
}

model Payout {
  id              String       @id @default(uuid())
  userId          String
  walletId        String
  paymentMethodId String?
  amount          Decimal
  currency        String       @default("PEN")
  status          PayoutStatus @default(REQUESTED)
  requestedAt     DateTime     @default(now())
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([walletId])
  @@index([paymentMethodId])
  @@index([status])
}

model Workshop {
  id            String         @id @default(uuid())
  title         String
  description   String?
  courseId      String?
  moduleId      String?
  communityId   String?
  facilitatorId String
  mode          WorkshopMode   @default(VIRTUAL)
  status        WorkshopStatus @default(DRAFT)
  location      String?
  materials     String?
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  course        Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module        Module?                @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  community     Community?             @relation(fields: [communityId], references: [id], onDelete: SetNull)
  facilitator   User                   @relation("FacilitatedWorkshops", fields: [facilitatorId], references: [id], onDelete: Restrict)
  registrations WorkshopRegistration[]
  attendances   Attendance[]
  announcements Announcement[]

  @@index([facilitatorId])
  @@index([status])
  @@index([startsAt])
  @@index([communityId])
}

model WorkshopRegistration {
  id           String                     @id @default(uuid())
  workshopId   String
  userId       String
  status       WorkshopRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                   @default(now())

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  attendances Attendance[]

  @@unique([workshopId, userId])
  @@index([userId])
}

model Attendance {
  id                     String           @id @default(uuid())
  workshopId             String
  userId                 String
  workshopRegistrationId String?
  attended               Boolean          @default(false)
  status                 AttendanceStatus @default(ABSENT)
  checkedInAt            DateTime?
  recordedById           String?
  createdAt              DateTime         @default(now())

  workshop             Workshop              @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  workshopRegistration WorkshopRegistration? @relation(fields: [workshopRegistrationId], references: [id], onDelete: SetNull)
  recordedBy           User?                 @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([workshopId, userId])
  @@index([workshopRegistrationId])
  @@index([recordedById])
}

model Announcement {
  id           String           @id @default(uuid())
  title        String
  body         String
  type         AnnouncementType @default(OTHER)
  institution  String?
  requirements String?
  officialUrl  String?
  startsAt     DateTime?
  endsAt       DateTime?
  publishedAt  DateTime?
  authorId     String?
  communityId  String?
  workshopId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  author    User?      @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  workshop  Workshop?  @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([communityId])
  @@index([workshopId])
  @@index([type])
}

model FacilitatorAssignment {
  id            String                      @id @default(uuid())
  facilitatorId String
  artisanId     String
  communityId   String?
  status        FacilitatorAssignmentStatus @default(ACTIVE)
  assignedAt    DateTime                    @default(now())
  endedAt       DateTime?
  notes         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  facilitator User              @relation("AssignmentFacilitator", fields: [facilitatorId], references: [id], onDelete: Restrict)
  artisan     User              @relation("AssignmentArtisan", fields: [artisanId], references: [id], onDelete: Restrict)
  community   Community?        @relation(fields: [communityId], references: [id], onDelete: SetNull)
  followUps   ArtisanFollowUp[]

  @@unique([facilitatorId, artisanId])
  @@index([facilitatorId, status])
  @@index([artisanId, status])
  @@index([communityId])
}

model ArtisanFollowUp {
  id             String           @id @default(uuid())
  assignmentId   String
  facilitatorId  String
  artisanId      String
  occurredAt     DateTime         @default(now())
  type           FollowUpType
  observation    String
  difficulty     String?
  recommendation String?
  commitment     String?
  nextFollowUpAt DateTime?
  priority       FollowUpPriority @default(MEDIUM)
  outcome        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment  FacilitatorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  facilitator User                  @relation("FollowUpFacilitator", fields: [facilitatorId], references: [id], onDelete: Restrict)
  artisan     User                  @relation("FollowUpArtisan", fields: [artisanId], references: [id], onDelete: Restrict)

  @@index([assignmentId, occurredAt])
  @@index([facilitatorId, occurredAt])
  @@index([artisanId, occurredAt])
  @@index([priority])
}

model Conversation {
  id          String   @id @default(uuid())
  title       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  participants Participant[]
  messages     Message[]

  @@index([createdById])
}

model Participant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  messageFiles MessageFile[]

  @@index([conversationId])
  @@index([senderId])
}

model MessageFile {
  id        String @id @default(uuid())
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model File {
  id        String   @id @default(uuid())
  url       String
  provider  String
  publicId  String?
  type      FileType
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altText   String?
  metadata  Json?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  coverStories Story[]       @relation("StoryCoverImage")
  moduleCovers Module[]      @relation("ModuleCoverFile")
  lessonFiles  LessonFile[]
  messageFiles MessageFile[]
  productImage ProductImage?
  certificate  Certificate?
  storyFiles   StoryFile[]

  @@index([ownerId])
  @@index([type])
  @@index([provider, publicId])
}

model LessonFile {
  id       String @id @default(uuid())
  lessonId String
  fileId   String
  order    Int    @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([lessonId, fileId])
  @@index([lessonId])
  @@index([lessonId, order])
  @@index([fileId])
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
}
